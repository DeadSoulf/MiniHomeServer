[Unit]
Description=Apply approved MiniHomeServer update from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/minihome-update-worker.py
TimeoutStartSec=300
RuntimeDirectory=minihome-update
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
# The application data directory is owned 0700 by minihome; the updater
# needs DAC override to read its request and back up SQLite without weakening
# the application's private-directory permissions. The backup may create
# root-owned WAL/SHM sidecars; CAP_CHOWN allows restoring their fixed paths
# to the application's uid before its next SQLite connection.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=
ReadWritePaths=/opt/minihome /opt/minihome-backups /var/lib/minihome /usr/local/libexec
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
