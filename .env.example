# Copy to .env on Debian and set a RANDOM password of at least 12 characters.
# Never commit .env to GitHub.
MINIHOME_ADMIN_PASSWORD=
# All interfaces by request; set 127.0.0.1 when using an HTTPS reverse proxy.
MINIHOME_BIND_ADDRESS=0.0.0.0
MINIHOME_PORT=8080
# Set to 1 only when using HTTPS in the browser.
MINIHOME_COOKIE_SECURE=0
